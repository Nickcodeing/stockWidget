{
  "name": "stock-widget",
  "version": "1.0.0",
  "description": "A股桌面悬浮行情插件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.stockwidget",
    "productName": "StockWidget",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "stocks.example.json",
      "icon.png",
      "position.json",
      "renderer/**/*"
    ]
  }
}
